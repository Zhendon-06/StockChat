# Never commit the real file. Copy to .env on the server.
PORT=3000
HOST=127.0.0.1
# DashScope OpenAI-compatible endpoint.
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace-with-dashscope-key
# Optional client-to-proxy token. Set this in production.
PROXY_AUTH_TOKEN=replace-with-a-long-random-token
# Comma-separated origins; use the app's web origin when needed.
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=120000
MAX_BODY_BYTES=2097152
